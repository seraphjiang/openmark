{
  "manifest_version": 3,
  "name": "OpenMark",
  "version": "0.1.1",
  "description": "Open-source Markdown viewer — syntax highlighting, diagrams, math, and more.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["file:///*", "*://*/*.md", "*://*/*.markdown"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["file:///*/*.md", "file:///*/*.markdown", "*://*/*.md", "*://*/*.markdown"],
      "js": ["content.js"],
      "css": ["assets/content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
