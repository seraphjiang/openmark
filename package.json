{
  "name": "openmark",
  "version": "0.1.12",
  "description": "Open-source Markdown viewer browser extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && python3 scripts/ascii-escape-content.py && vite build --config vite.config.pages.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/chrome": "^0.0.287",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.0",
    "katex": "^0.16.0",
    "markdown-it": "^14.1.0",
    "markdown-it-katex": "^2.0.3",
    "mermaid": "^11.4.0"
  }
}
